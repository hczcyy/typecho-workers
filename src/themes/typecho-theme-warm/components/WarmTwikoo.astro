---
// WarmTwikoo.astro
// Twikoo 评论组件，替换原 WarmComments
---

<div id="tcomment"></div>

<script is:inline src="https://registry.npmmirror.com/twikoo/1.7.11/files/dist/twikoo.min.js"></script>

<script is:inline>
function initTwikoo() {
  if (typeof twikoo === 'undefined' || !twikoo.init) {
    setTimeout(initTwikoo, 100);
    return;
  }

  var path = window.location.pathname.replace(/\/$/, '').replace(/\/index\.html$/, '') || '/';
  if (window.__twikoo_path === path) return;
  window.__twikoo_path = path;

  var container = document.getElementById('tcomment');
  if (container) container.innerHTML = '';

  twikoo.init({
    envId: 'https://twikoo.mrhe.net',
    el: '#tcomment',
    path: path,
    lang: 'zh-CN',
  });
}

setTimeout(initTwikoo, 0);

// InstantClick 切换页面后重新初始化
window.addEventListener('instantclick:newpage', function () {
  window.__twikoo_path = null;
  setTimeout(initTwikoo, 0);
});
</script>
